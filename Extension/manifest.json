{
  "manifest_version": 3,
  "name": "Browser Again",
  "version": "1.1.0",
  "description": "Block distracting sites. Open YouTube with a timed five-minute pass.",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "blocked_sites",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "detect-nitter.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube-guard.js"
      ],
      "css": [
        "youtube-guard.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "youtube.html"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  }
}
